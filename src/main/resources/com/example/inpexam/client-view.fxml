<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="267.0" prefWidth="448.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.inpexam.ClientController">
   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#01e665" height="51.0" stroke="BLACK" strokeLineCap="ROUND" strokeType="OUTSIDE" strokeWidth="0.5" width="448.0" />
      <Label fx:id="lblUserName" layoutX="28.0" layoutY="20.0" prefHeight="20.0" prefWidth="55.0" text="Amal" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Button fx:id="btnDisconnect" layoutX="342.0" layoutY="17.0" mnemonicParsing="false" onAction="#onActionDisconnect" style="-fx-background-color: red;" text="Disconnect" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <TextArea fx:id="txtArea" layoutX="95.0" layoutY="107.0" prefHeight="82.0" prefWidth="259.0" />
      <TextField fx:id="txtMessage" layoutX="95.0" layoutY="209.0" onAction="#onActionSend">
         <effect>
            <InnerShadow blurType="ONE_PASS_BOX">
               <color>
                  <Color opacity="0.3604061007499695" />
               </color>
            </InnerShadow>
         </effect>
      </TextField>
      <Button fx:id="btnSend" layoutX="290.0" layoutY="209.0" mnemonicParsing="false" onAction="#onActionSend" style="-fx-background-color: #01e665;" text="Place Bid" textFill="#004c21" />
      <TextArea fx:id="txtAreaInfoPanel" layoutX="21.0" layoutY="58.0" prefHeight="40.0" prefWidth="408.0" />
   </children>
</AnchorPane>
