<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="347.0" prefWidth="338.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.inpexam.ServerController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <AnchorPane prefHeight="251.0" prefWidth="298.0">
      <children>
         <Button layoutX="231.0" layoutY="12.0" mnemonicParsing="false" text="End" textFill="RED" />
         <Label layoutX="21.0" layoutY="8.0" text="Server" textFill="#0022ff">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         <TextArea fx:id="txtArea" layoutX="49.0" layoutY="95.0" prefHeight="95.0" prefWidth="200.0" scrollLeft="5.0" scrollTop="5.0" />
         <TextField fx:id="txtItem" layoutX="75.0" layoutY="50.0" onAction="#onActionSetItem" />
      </children>
   </AnchorPane>
   <TextField fx:id="txtMessage" onAction="#onActionSend" prefHeight="25.0" prefWidth="145.0" />
    <Button fx:id="btnSend" onAction="#onActionSend" text="Send" textFill="#1b07f4" />
</VBox>
